# copy this file to jenkins-ci/.env and fill in the values.
# jenkins-ci/.env is ignored by git - never commit real passwords or tokens !!!!!!!!!!!!!!!!!

JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# GitHub account and classic token
GITHUB_USERNAME=your-github-login
GITHUB_TOKEN=change-me

# password of the "jenkins" user in Nexus
NEXUS_JENKINS_PASSWORD=change-me
