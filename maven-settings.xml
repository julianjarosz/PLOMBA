<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.3.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.3.0 https://maven.apache.org/xsd/settings-1.3.0.xsd">
    <mirrors>
        <mirror>
            <id>nexus-public</id>
            <name>Wspolne repozytorium PLOMBA</name>
            <url>${env.NEXUS_URL}/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
    <servers>
        <server>
            <id>nexus-deploy</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
            <repositoryOrigins>
                <repositoryOrigin>${env.NEXUS_URL}</repositoryOrigin>
            </repositoryOrigins>
        </server>
    </servers>
</settings>
