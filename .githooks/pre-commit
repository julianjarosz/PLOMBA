#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
files=()
patterns=()
while IFS= read -r -d '' file; do
    case "$file" in
        *','*|*'\'*) echo "Nieobsługiwana nazwa pliku: $file" >&2; exit 1 ;;
    esac
    files+=("$file")
    patterns+=(".*\Q/${file#PLOMBA/plomba/}\E")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- \
    'PLOMBA/plomba/src/main/java/*.java' 'PLOMBA/plomba/src/test/java/*.java')

[ "${#files[@]}" -gt 0 ] || exit 0

if ! git diff --quiet -- "${files[@]}"; then
    echo "Commit zatrzymany: plik Java dodany do commita ma również niewybrane zmiany." >&2
    echo "Dodaj cały ten plik albo odłóż jego pozostałe zmiany i ponów commit." >&2
    exit 1
fi

selection=$(IFS=,; echo "${patterns[*]}")
if ! (cd PLOMBA/plomba && sh mvnw -B -ntp spotless:apply "-DspotlessFiles=$selection"); then
    echo "Commit zatrzymany: formatter nie zakończył się poprawnie. Sprawdź błąd powyżej i JDK." >&2
    exit 1
fi

git add -- "${files[@]}"
